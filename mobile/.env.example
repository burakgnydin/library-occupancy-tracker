# API base URL
# Not: Web preview veya iOS simulator'da "localhost" calisir.
# Fiziksel cihazda veya Android emulator'de "localhost" bilgisayarin kendisine (cihaza degil) isaret eder.
# Bu durumda bilgisayarinizin yerel agdaki IP adresini kullanin, orn: http://192.168.1.23:5200/api
# (Android emulator icin ozel olarak 10.0.2.2 host makineye karsilik gelir: http://10.0.2.2:5200/api)
EXPO_PUBLIC_API_BASE_URL=http://localhost:5200/api
